---
// Every page on a club site is built by this one file.
// content/pages/home.md becomes "/", content/pages/mt-buller.md becomes "/mt-buller/".
//
// Layouts:
//   full     intro text, then full-width sections (each can have a
//            white, tint or dark background)
//   sidebar  main column plus a narrower sidebar

import { getCollection } from 'astro:content';
import Base from '../components/Base.astro';
import Blocks from '../components/Blocks.astro';
import Markdown from '../components/Markdown.astro';
import HeroExtras from '../components/HeroExtras.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => !p.data.hidden);
  if (!pages.some((p) => p.id === 'home')) {
    throw new Error('There is no home page. content/pages/home.md must exist and must not be hidden.');
  }
  return pages.map((page) => ({
    params: { slug: page.id === 'home' ? undefined : page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const d = page.data;
const isHome = page.id === 'home';
// Large, medium and split heroes show the page title; otherwise the page does.
const titleInHero = ['large', 'medium', 'split'].includes(d.hero.style);
const intro = page.body?.trim();
// When the title isn't on the photo, the hero's text and buttons go under it.
const heroExtras = !titleInHero && (d.hero.text || d.hero.buttons.length > 0);
---

<Base title={isHome ? undefined : d.title} pageTitle={d.title} description={d.description} hero={d.hero}>
  {
    d.layout === 'full' && (
      <>
        {(!titleInHero || intro) && (
          <div class="band band-white page-intro">
            <div class="container">
              {!titleInHero && <h1>{d.title}</h1>}
              {heroExtras && <HeroExtras hero={d.hero} />}
              {intro && <Markdown source={intro} class="lead" />}
            </div>
          </div>
        )}
        <Blocks blocks={d.blocks} />
      </>
    )
  }
  {
    d.layout === 'sidebar' && (
      <div class="band band-white">
        <div class="container layout-sidebar">
          <div class="main-column">
            {!titleInHero && <h1>{d.title}</h1>}
            {heroExtras && <HeroExtras hero={d.hero} />}
            {intro && <Markdown source={intro} class="lead" />}
            <Blocks blocks={d.blocks} inColumn />
          </div>
          {d.sidebar.length > 0 && (
            <aside class="side-column" aria-label="More information">
              <Blocks blocks={d.sidebar} inColumn compact />
            </aside>
          )}
        </div>
      </div>
    )
  }
</Base>
