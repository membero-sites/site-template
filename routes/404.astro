---
// Shown for any address that doesn't exist. Hosting must rewrite unknown
// paths to /404.html with status 404 (see the runbook).
import Base from '../components/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="band band-white page-intro">
    <div class="container measure">
      <h1>Page not found</h1>
      <p>That page doesn't exist. It may have moved when the website was updated.</p>
      <p><a class="button" href="/">Go to the home page</a></p>
    </div>
  </div>
</Base>
