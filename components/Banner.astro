---
// Banner under the header. One image shows still. Two or more fade in turn
// every 6 seconds (scripts/site.js), with a pause button. Visitors who have
// "reduce motion" turned on see the first image only.
//
// Banner images are decorative (empty alt text). Images narrower than
// 1500px are shown at up to 1200px wide, centred on the club's dark colour,
// so low-resolution photos aren't stretched and blurry.

import { Picture } from 'astro:assets';

interface Props {
  images: ImageMetadata[];
  height: 'standard' | 'short';
}
const { images, height } = Astro.props;
const many = images.length > 1;
const NARROW = 1500;
---

<section class:list={['banner', `banner-${height}`]} data-slideshow={many ? '' : undefined} aria-label="Photos">
  {
    images.map((img, i) => (
      <div class:list={['slide', { 'is-active': i === 0, 'is-narrow': img.width < NARROW }]}>
        <Picture
          src={img}
          alt=""
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1600, 2000].filter((w) => w <= img.width).concat(img.width < 640 ? [img.width] : [])}
          sizes={img.width < NARROW ? '(max-width: 1200px) 100vw, 1200px' : '(max-width: 2000px) 100vw, 2000px'}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      </div>
    ))
  }
  {
    many && (
      <button class="slideshow-toggle" type="button" hidden aria-pressed="false">
        Pause photos
      </button>
    )
  }
</section>
