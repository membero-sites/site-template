---
// Site header: logo, main menu and the optional header button (usually the
// booking service link).
//
// Two looks, set in Site settings > Look:
//   solid      white header above the page
//   overPhoto  see-through header on top of large and medium top photos,
//              using the logo for dark backgrounds. Other pages get solid.
//
// On phones the menu collapses behind a Menu button. Without JavaScript
// the menu simply stays open.

import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { isExternal, samePath } from '../lib/links.mjs';

interface Props {
  overPhoto?: boolean;
}
const { overPhoto = false } = Astro.props;
const { data: s } = await getEntry('settings', 'site');
const here = Astro.url.pathname;
const btn = s.headerButton;
const logo = overPhoto && s.logoOnDark ? s.logoOnDark : s.logoOnLight;
---

<header class:list={['site-header', overPhoto ? 'header-over-photo' : 'header-solid']}>
  <div class="container header-inner">
    <a class="brand" href="/">
      <Image src={logo} alt={`${s.name} home`} height={64} densities={[1, 2]} loading="eager" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-icon" aria-hidden="true"></span>
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          s.menu.map((item) => (
            <li>
              <a href={item.link} aria-current={!isExternal(item.link) && samePath(item.link, here) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        btn.show && btn.label && btn.link && (
          <a class="button header-button" href={btn.link}>
            {btn.label}
          </a>
        )
      }
    </nav>
  </div>
</header>
