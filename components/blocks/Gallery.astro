---
// Gallery: a grid of images. Each links to the full-size version.
import { Image, getImage } from 'astro:assets';
import { IMAGE_FORMAT, SIZES, widthsFor } from '../../lib/widths.mjs';
const { block } = Astro.props;
const items = await Promise.all(
  block.images.map(async (item) => ({
    ...item,
    full: await getImage({ src: item.image, width: Math.min(item.image.width, 2000), format: 'webp' }),
  })),
);
---

<ul class="gallery">
  {
    items.map((item) => (
      <li>
        <figure>
          <a href={item.full.src}>
            <Image
              src={item.image}
              alt={item.alt}
              format={IMAGE_FORMAT}
              widths={widthsFor(item.image, SIZES.thumb)}
              sizes="(max-width: 600px) 50vw, 300px"
            />
          </a>
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      </li>
    ))
  }
</ul>
