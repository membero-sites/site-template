---
// Image block: one image with optional caption.
import { Image } from 'astro:assets';
import { IMAGE_FORMAT, SIZES, widthsFor } from '../../lib/widths.mjs';
const { block, compact } = Astro.props;
---

<figure class="figure">
  <Image
    src={block.image}
    alt={block.alt}
    format={IMAGE_FORMAT}
    widths={widthsFor(block.image, SIZES.content)}
    sizes={compact ? '(max-width: 900px) 100vw, 400px' : '(max-width: 1200px) 100vw, 1200px'}
  />
  {block.caption && <figcaption>{block.caption}</figcaption>}
</figure>
