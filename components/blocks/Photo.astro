---
// Full-width photo: one big picture across the screen between sections.
// In a sidebar or column it shows as a normal image.
import { Image } from 'astro:assets';
import { IMAGE_FORMAT, SIZES, widthsFor } from '../../lib/widths.mjs';
const { block, inColumn } = Astro.props;
const widths = widthsFor(block.image, SIZES.photo);
---

<figure class:list={['photo', `photo-${block.height}`, { 'photo-in-column': inColumn }]}>
  <Image src={block.image} alt={block.alt} format={IMAGE_FORMAT} widths={widths} sizes={inColumn ? '(max-width: 900px) 100vw, 700px' : '100vw'} loading="lazy" />
  {block.caption && <figcaption>{block.caption}</figcaption>}
</figure>
