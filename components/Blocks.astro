---
// Renders a list of page blocks.
//
// In the full-width layout each block is a band across the page with its
// own background (white, tint or dark). In the sidebar layout ("inColumn")
// blocks stack inside the column and backgrounds are ignored. "compact" is
// the narrow sidebar itself.

import Text from './blocks/Text.astro';
import SingleImage from './blocks/SingleImage.astro';
import ImageText from './blocks/ImageText.astro';
import Photo from './blocks/Photo.astro';
import Gallery from './blocks/Gallery.astro';
import LodgeCards from './blocks/LodgeCards.astro';
import Facts from './blocks/Facts.astro';
import Cta from './blocks/Cta.astro';
import MapBlock from './blocks/Map.astro';
import Video from './blocks/Video.astro';
import Faq from './blocks/Faq.astro';
import TariffTable from './blocks/TariffTable.astro';
import Embed from './blocks/Embed.astro';
import ContactList from './blocks/ContactList.astro';
import SnowCams from './blocks/SnowCams.astro';

interface Props {
  blocks: any[];
  inColumn?: boolean;
  compact?: boolean;
}
const { blocks, inColumn = false, compact = false } = Astro.props;

const COMPONENTS = {
  text: Text,
  image: SingleImage,
  imageText: ImageText,
  photo: Photo,
  gallery: Gallery,
  lodgeCards: LodgeCards,
  facts: Facts,
  cta: Cta,
  map: MapBlock,
  video: Video,
  faq: Faq,
  tariffTable: TariffTable,
  embed: Embed,
  contactList: ContactList,
  snowCams: SnowCams,
};

// Blocks that place their own heading (beside an image, not above it).
const OWN_HEADING = new Set(['imageText']);

// Blocks whose text should stay at a readable line length.
const NARROW = new Set(['text', 'faq', 'cta', 'map', 'video', 'facts']);

// Paid one-off components live in the club repo's custom/ folder.
const customComponents = import.meta.glob('/custom/*.astro', { eager: true });
function customFor(name) {
  const mod = customComponents[`/custom/${name}.astro`];
  if (!mod) throw new Error(`Custom block "${name}" needs a file at custom/${name}.astro in the club repo.`);
  return mod.default;
}
---

{
  blocks.map((block) => {
    const Component = block.type === 'custom' ? customFor(block.name) : COMPONENTS[block.type];
    const fullBleed = block.type === 'photo' && !inColumn;

    if (inColumn) {
      return (
        <section class:list={['block', `block-${block.type}`, { compact }]}>
          {block.heading && !OWN_HEADING.has(block.type) && <h2>{block.heading}</h2>}
          <Component block={block} compact={compact} inColumn />
        </section>
      );
    }
    if (fullBleed) {
      return (
        <section class="band band-photo">
          <Component block={block} />
        </section>
      );
    }
    return (
      <section class:list={['band', `band-${block.background}`, `block-${block.type}`]}>
        <div class:list={['container', { measure: NARROW.has(block.type) }]}>
          {block.heading && !OWN_HEADING.has(block.type) && <h2>{block.heading}</h2>}
          <Component block={block} />
        </div>
      </section>
    );
  })
}
